# Copy this file to config.env and fill in the MySQL details from hPanel.
# Use a new database on the same MySQL server as HRMS and TMS.
# Leave this file unused on your own PC if you only want the local database file.
# The first time the checker opens, it asks you to choose the admin password
# and the agent password. Those are stored here as hashes. Do not share this file.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=creator_checker
